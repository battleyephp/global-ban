{
  "name": "battleyephp/global-ban",
  "description": "PHP BattlEye Global Ban Checker",
  "type": "package",
  "keywords": ["php", "battleye", "client", "udp", "socket", "arma"],
  "homepage": "https://github.com/battleyephp/global-ban",
  "license": "MIT",
  "authors": [
    {
      "name": "Smith",
      "email": "smitt14ua@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-sockets": "*",
    "battleyephp/guid": "^1.0"
  },
  "require-dev": {
    "laravel/pint": "^1.22",
    "pestphp/pest": "^3.8",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "BattlEye\\GlobalBan\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "refactor": "rector",
    "lint": "pint",
    "test:refactor": "rector --dry-run",
    "test:lint": "pint --test",
    "test:types": "phpstan analyse --ansi",
    "test:unit": "pest --colors=always --coverage --min=55.1 --parallel",
    "test": [
      "@test:refactor",
      "@test:lint",
      "@test:types",
      "@test:unit"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
